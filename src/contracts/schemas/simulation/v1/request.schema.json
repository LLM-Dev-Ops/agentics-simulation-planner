{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentics.io/schemas/simulation/v1/request.schema.json",
  "title": "Agentics Simulation Planner Request",
  "description": "Schema for simulation planning requests. All requests must conform to this schema before any planning operations begin.",
  "type": "object",
  "required": ["intent"],
  "additionalProperties": false,
  "properties": {
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "description": "Natural language organizational goal describing what simulation should be planned"
    },
    "organizationId": {
      "type": "string",
      "format": "uuid",
      "description": "UUID of the organization. If not provided, one will be generated deterministically from organizationName"
    },
    "organizationName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Name of the organization. Defaults to 'Default Organization' if not provided"
    },
    "seed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Optional seed for deterministic plan generation. Same seed + same intent = same plan"
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9_-]+$",
      "description": "Namespace for ruvvector storage isolation. Defaults to 'default'"
    },
    "config": {
      "$ref": "#/$defs/SimulationConfig",
      "description": "Optional simulation configuration parameters"
    },
    "scenario": {
      "$ref": "#/$defs/ScenarioDefinition",
      "description": "Optional scenario definition for constrained planning"
    }
  },
  "$defs": {
    "SimulationConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targetEngine": {
          "type": "object",
          "required": ["engine", "versionConstraint"],
          "additionalProperties": false,
          "properties": {
            "engine": {
              "type": "string",
              "enum": ["agentics-simulation-engine"],
              "description": "Target simulation engine identifier"
            },
            "versionConstraint": {
              "type": "string",
              "pattern": "^[\\^~>=<|\\s0-9.x*-]+$",
              "description": "Semantic version constraint for engine compatibility"
            },
            "requiredCapabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "description": "Required engine capabilities for this plan"
            }
          }
        },
        "scope": {
          "$ref": "#/$defs/ScopeConfig"
        },
        "constraints": {
          "$ref": "#/$defs/ConstraintsConfig"
        },
        "policies": {
          "$ref": "#/$defs/PoliciesConfig"
        }
      }
    },
    "ScopeConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["FULL", "PARTIAL", "INCREMENTAL"],
          "description": "Scope type for the simulation"
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["FINANCE", "HUMAN_RESOURCES", "OPERATIONS", "SUPPLY_CHAIN", "CUSTOMER_RELATIONSHIP", "PROJECT_MANAGEMENT", "ASSET_MANAGEMENT", "PROCUREMENT"]
          },
          "uniqueItems": true,
          "description": "ERP domains in scope"
        },
        "timeHorizon": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "startDate": {
              "type": "string",
              "format": "date-time"
            },
            "endDate": {
              "type": "string",
              "format": "date-time"
            },
            "granularity": {
              "type": "string",
              "enum": ["HOUR", "DAY", "WEEK", "MONTH", "QUARTER", "YEAR"]
            }
          }
        },
        "dataVolume": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minRecords": {
              "type": "integer",
              "minimum": 0
            },
            "maxRecords": {
              "type": "integer",
              "minimum": 1
            },
            "estimatedRecords": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "ConstraintsConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "temporal": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "startAfter": {
              "type": "string",
              "format": "date-time"
            },
            "completeBefore": {
              "type": "string",
              "format": "date-time"
            },
            "maxDurationMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 86400000
            },
            "timezone": {
              "type": "string"
            }
          }
        },
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxAgents": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "maxConcurrency": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "maxMemoryMB": {
              "type": "integer",
              "minimum": 128,
              "maximum": 1048576
            },
            "maxCost": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "PoliciesConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executionMode": {
          "type": "string",
          "enum": ["strict", "lenient", "adaptive"]
        },
        "failureHandling": {
          "type": "string",
          "enum": ["fail-fast", "continue", "retry"]
        },
        "auditLevel": {
          "type": "string",
          "enum": ["minimal", "standard", "detailed", "full"]
        }
      }
    },
    "ScenarioDefinition": {
      "type": "object",
      "required": ["scenarioId", "name"],
      "additionalProperties": false,
      "properties": {
        "scenarioId": {
          "type": "string",
          "format": "uuid",
          "description": "Unique identifier for this scenario"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Human-readable scenario name"
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "description": "Detailed scenario description"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "array", "items": { "type": "string" } }
            ]
          },
          "description": "Scenario-specific parameters"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "statement"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "category": {
                "type": "string",
                "enum": ["technical", "business", "operational", "environmental"]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "description": "Assumptions underlying this scenario"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true,
          "description": "IDs of other scenarios this depends on"
        }
      }
    }
  }
}
